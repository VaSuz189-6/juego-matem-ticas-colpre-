{
  "name": "desafio-matematico",
  "version": "1.0.0",
  "description": "Juego educativo de operaciones.",
  "main": "electron/main.js",
  "author": "Cristhian Vargas Y Nancy Suarez",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "co.desafiomatematico.app",
    "productName": "Desafio Matematico",
    "asar": true,
    "files": [
      "electron/**/*",
      "html/**/*",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "CEVS",
      "repo": "juego-matem-ticas-colpre-"
    },
    "win": {
      "target": [{
        "target": "nsis",
        "arch": ["x64"]
      }],
      "artifactName": "juego-matem-ticas-colpre-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
